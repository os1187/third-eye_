{
  "camera": {
    "width": 1280,
    "height": 720,
    "fps": 20,
    "camera_id": 0,
    "buffer_size": 1,
    "auto_exposure": false,
    "force_fps": true,
    "prefer_continuity": true,
    "prefer_network_rgb": false
  },
  "yolo": {
    "weights": "yolov8s.pt",
    "img_size": 480,
    "conf": 0.30,
    "iou": 0.60,
    "max_det": 30,
    "ensemble": false,
    "augment": false,
    "custom_classes": [
      "person",
      "bicycle",
      "car",
      "motorcycle",
      "bus",
      "truck",
      "traffic light",
      "stop sign",
      "chair",
      "bed",
      "bottle"
    ],
    "tracker": true,
    "ema_smoothing": true,
    "navigation_priority_classes": [
      "person",
      "bicycle",
      "car",
      "motorcycle",
      "bus",
      "truck",
      "traffic light",
      "stop sign",
      "chair",
      "bed",
      "bottle"
    ],
    "class_conf_overrides": {
      "bed": 0.90,
      "bottle": 0.30
    },
    "use_coreml": false,
    "coreml_package_path": "models/yolo11n.mlpackage"
  },
  "depth": {
    "enabled": false,
    "model": "depth-anything/Depth-Anything-V2-Small-hf",
    "alpha": 0.6,
    "min_interval": 0.025,
    "fast_mode": true,
    "resolution": 480,
    "skip_frames": 1,
    "batch_processing": false,
    "source": "local",
    "network_units": "millimeters",
    "network_scale": 1.0,
    "min_m": 0.2,
    "max_m": 5.0
  },
  "distances": {
    "warning": 1.6,
    "critical": 0.6,
    "nearby": 3.0
  },
  "speed_detection": {
    "fast_speed_threshold": 1.5,
    "very_fast_threshold": 3.0,
    "min_samples_for_speed": 5,
    "speed_window_seconds": 2.0,
    "center_corridor_blend_in": 0.8,
    "center_corridor_blend_out": 0.5
  },
  "announcements": {
    "enabled": true,
    "cooldown": 3.0,
    "class_cooldown": 4.0,
    "min_conf": 0.20,
    "ai_decider": true,
    "crowd_slow_person_importance_mult": 1.2,
    "instant_hazard": true,
    "smart_verbosity": true,
    "smart_ttc": true,
    "summary_interval_s": 9.0,
    "importance_boost_under_load": 1.15,
    "class_quota_window_s": 4.0,
    "class_quota_default_max": 2,
    "class_quota_overrides": {
      "person": 3,
      "car": 1,
      "bicycle": 2
    },
    "adaptive_cooldown": true,
    "cooldown_under_load_multiplier": 1.3,
    "fairness_bias_enabled": true,
    "hysteresis_enabled": true,
    "hysteresis_window_s": 5.0,
    "hysteresis_delta": 0.08,
    "label_side_dedup_window_s": 4.0
    ,
    "intent_enabled": true,
    "side_round_robin_enabled": true,
    "realtime_bundle_max": 2,
    "bundle_combine_enabled": true,
    "micro_guidance_enabled": true,
    "compact_style_enabled": true,
    "compact_trigger_noise_level": 0.7,
    "compact_trigger_under_load": true,
    "semantic_scene_brief_enabled": true,
    "coaching_mode_enabled": true,
    "ai_phrase_variety_enabled": true,
    "ai_personalization_enabled": true,
    "style_profile": "concise",
    "phrasing_provider": "builtin",
    "phrasing_enabled": false,
    "phrasing_timeout_s": 2.0,
    "fallback_enabled": true,
    "shortcuts_bind": "0.0.0.0",
    "shortcuts_port": 8766
  },
  "audio": {
    "speech_volume": 0.9,
    "enqueue_rate_limit_s": 0.8,
    "max_queue_size": 4,
    "dedup_window_s": 4.0,
    "global_min_speak_gap_s": 0.9,
    "urgent_preempt": true,
    "smart_fps_threshold": 12.0,
    "smart_queue_latency_s": 0.7,
    "tts_provider": "local",
    "voice_id": "",
    "tts_timeout_s": 3.0,
    "earcons_enabled": false,
    "announce_server_bound": false,
    "startup_status_enabled": false,
    "earcon_volume": 0.5,
    "global_silence_after_critical_s": 1.8,
    "hint_block_after_critical_s": 1.2,
    "ttc_urgent_s": 1.5,
    "ttc_warning_s": 3.0,
    "ttc_caution_s": 6.0,
    "ttc_instant_prediction": true,
    "ttc_prediction_min_speed_mps": 0.6,
    "ttc_prediction_min_dt_s": 0.25,
    "ttc_prediction_deadband_m": 0.05,
    "summary_min_items": 2,
    "summary_group_window_s": 1.5,
    "intent_countdown_min_s": 1.2,
    "intent_countdown_max_s": 3.5
  },
  "multimodal_cues": {
    "voice_noise_threshold": 0.9,
    "tts_backlog_threshold": 8,
    "voice_always_for_critical": true
  },
  "spatial_audio": {
    "min_interval_s": 1.5,
    "noise_trigger_level": 0.85,
    "max_distance": 8.0
  },
  "haptics": {
    "heartbeat_enabled": true,
    "heartbeat_interval_s": 3.5,
    "per_track_interval_s": 5.0,
    "heartbeat_level": "nearby"
  },
  "hazard": {
    "boost_duration_s": 1.6,
    "yolo_interval_s": 0.05,
    "depth_min_interval_s": 0.02,
    "yolo_imgsz_boost": 480,
    "depth_resolution_boost_min": 480,
    "looming_speed_threshold_mps": 1.2,
    "looming_depth_threshold_m": 2.0,
    "looming_cooldown_s": 3.0,
    "telemetry_logging": true,
    "min_depth_valid_ratio": 0.2,
    "min_below_critical_fraction": 0.06,
    "min_below_critical_pixels": 250,
    "fallback_persist_s": 0.35,
    "min_roi_valid_fraction": 0.04,
    "min_roi_valid_pixels": 60
  },
  "lane_guidance": {
    "enabled": true,
    "multi_lane_detection": true,
    "path_scoring_enabled": true,
    "audio_guidance_enabled": true,
    "visual_feedback_enabled": false,
    "lane_analysis": {
      "min_lane_width_m": 0.8,
      "max_lane_width_m": 3.0,
      "lane_merge_threshold": 0.3,
      "path_smoothing_factor": 0.7,
      "confidence_threshold": 0.6
    },
    "path_scoring": {
      "width_weight": 0.4,
      "depth_weight": 0.3,
      "obstacle_penalty_weight": 0.2,
      "continuity_weight": 0.1,
      "center_preference_factor": 0.15
    },
    "steering_guidance": {
      "max_steering_angle_deg": 30.0,
      "gentle_correction_threshold_deg": 5.0,
      "sharp_correction_threshold_deg": 15.0,
      "guidance_update_interval_s": 0.5,
      "path_prediction_distance_m": 3.0
    },
    "audio_feedback": {
      "guidance_phrases": {
        "slight_left": "Slight left",
        "slight_right": "Slight right", 
        "turn_left": "Turn left",
        "turn_right": "Turn right",
        "sharp_left": "Sharp left",
        "sharp_right": "Sharp right",
        "straight_ahead": "Straight ahead",
        "path_clear": "Path clear",
        "narrow_passage": "Narrow passage ahead",
        "path_blocked": "Path blocked"
      },
      "guidance_interval_s": 2.0,
      "urgent_guidance_interval_s": 1.0
    }
  },
  "recording": {
    "enabled": false,
    "output_dir": "recordings",
    "max_duration": 300
  },
  "logging": {
    "level": "INFO",
    "file": "logs/third_eye.log"
  },
  "performance": {
    "max_workers": 4,
    "adaptive_quality": false,
    "target_fps": 20,
    "min_fps": 12,
    "quality_levels": [
      0.7,
      0.9,
      1.0
    ],
    "profiling": false,
    "frame_skip": 1,
    "depth_skip": 2,
    "yolo_skip": 0,
    "preproc_buffer_size": 6,
    "max_frame_skip": 2,
    "max_depth_skip": 3,
    "max_yolo_skip": 3
  },
  "free_space": {
    "depth_free_m": 2.5
  },
  "rgbd": {
    "port": 6000,
    "bind_host": "172.20.10.13",
    "client_host": "",
    "client_port": 6000
  },
  "network_depth_freshness_s": 0.8,
  "network_depth_freshness_s_per_mode": {
    "WALKING": 0.8,
    "CYCLING": 1.0,
    "DRIVING": 1.2
  }
}
